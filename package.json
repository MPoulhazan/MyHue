{
    "name": "myhue",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "agent": "node server/agentServer.js",
        "telegram": "node server/telegramBot.js",
        "start": "concurrently --names \"agent,telegram,front\" --prefix-colors \"cyan,yellow,magenta\" \"node server/agentServer.js\" \"node server/telegramBot.js\" \"vite\"",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "node --test server/*.test.js",
        "discover-bridge": "node scripts/discover-bridge.js",
        "generate-token": "node scripts/generate-token.js",
        "discover-cast": "node scripts/discover-cast.js"
    },
    "dependencies": {
        "@distube/ytdl-core": "^4.16.12",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "axios": "^1.13.5",
        "castv2-client": "^1.2.0",
        "dotenv": "^17.3.1",
        "express": "^5.1.0",
        "framer-motion": "^12.34.0",
        "kiwicam-broadlinkjs-rm": "^0.9.22",
        "mdns-js": "^1.0.3",
        "mqtt": "^5.15.0",
        "node-telegram-bot-api": "^0.67.0",
        "onnxruntime-web": "^1.30.0",
        "qr-scanner": "^1.4.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.13.0",
        "recharts": "^3.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.3.1"
    }
}
