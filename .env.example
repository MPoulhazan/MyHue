# Philips Hue Bridge Configuration
VITE_HUE_BRIDGE_IP=
VITE_HUE_USERNAME=

# Groq AI Configuration (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_PORT=5174

# Telegram Bot Configuration (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
AGENT_API_URL=http://localhost:5174

# Google Cast / Google Home / Chromecast
# Auto-discovery is enabled, but you can also manually configure devices:
# CAST_DEVICES=Living Room:192.168.0.100,Bedroom:192.168.0.101

# YouTube Music Configuration (https://console.cloud.google.com)
# Create a project, enable "YouTube Data API v3", then create an API key
YOUTUBE_API_KEY=your_youtube_api_key_here
# Default playlists (format: Name:PlaylistID,Name2:PlaylistID2)
# YOUTUBE_DEFAULT_PLAYLISTS=Lofi Beats:PLxxxxxxx,Chill Vibes:PLyyyyyyy
